  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "brand:wordmark": "python3 scripts/brand/generate-wordmark.py",
    "brand:icons": "python3 scripts/brand/generate-icons.py",
    "preview:web": "EXPO_PUBLIC_WEB_PREVIEW=1 EXPO_PUBLIC_DESIGN_LAB=1 expo export --platform web --output-dir dist-preview/web && python3 scripts/preview/build-single-file.py"
