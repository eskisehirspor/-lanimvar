# ── App (public, bundled into the binary) ─────────────────────────────────────
# Local: `npx supabase start` prints these. Production: Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPPORT_EMAIL=destek@example.com
EXPO_PUBLIC_SUPPORT_PHONE=
# Set to 1 to include the Design Lab in a non-development (preview) build.
EXPO_PUBLIC_DESIGN_LAB=

# ── Build-time (not bundled) ──────────────────────────────────────────────────
EAS_PROJECT_ID=
GOOGLE_MAPS_ANDROID_API_KEY=

# ── Supabase local auth providers (read by supabase/config.toml) ──────────────
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=app.ilanimvar
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
